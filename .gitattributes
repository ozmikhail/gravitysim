# Normalize line endings for all text files
* text=auto eol=lf

# Explicit text files
*.txt     text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.xml     text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.jsx     text eol=lf
*.tsx     text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary files (no line ending conversion)
# Images
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.bmp   binary
*.webp  binary

# Documents
*.pdf   binary

# Fonts
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.eot   binary

# Archives & Compressed files
*.zip   binary
*.tar   binary
*.gz    binary
*.rar   binary
*.7z    binary

# Media files
*.mp3   binary
*.mp4   binary
*.avi   binary
*.mov   binary
*.wav   binary

# Executables & Libraries
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary

# Databases & Other binaries
*.db    binary
*.sqlite binary
*.sqlite3 binary
*.bin   binary
*.dat   binary